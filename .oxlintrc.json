{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off"
  },
  "plugins": ["react", "nextjs", "typescript", "jsx-a11y"],
  "ignorePatterns": ["node_modules", ".next", "dist", "build"]
}
